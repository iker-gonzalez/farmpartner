# Claude (optional: without it the bot uses a keyword router)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Twilio (WhatsApp sandbox and/or SMS). Without these, outbound messages are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# Public URL of this server (ngrok/Fly/Render). Used for report links and Twilio signature checks.
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_TOKEN=change-me
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (default: local SQLite)
