# Copy to terraform.tfvars (gitignored). Everything is optional except image, which scripts/deploy.sh passes.
# image = "europe-west1-docker.pkg.dev/launchpad-all-dev-01/launchpad-all-docker-ar-dev-01/farmpartner:<tag>"

# Leave empty to keep the value already in Secret Manager (recommended for the database URL:
# use scripts/set-db-secret.sh so the password never enters Terraform state).
# database_url       = ""
# Claude via Workload Identity Federation (preferred, no key). IDs from Claude Console → Workload identity:
# anthropic_federation_rule_id = "fdrl_..."
# anthropic_organization_id    = "..."
# anthropic_service_account_id = "svac_..."
# anthropic_workspace_id       = "wrkspc_..."
# Or a plain API key instead:
# anthropic_api_key  = "sk-ant-..."
# twilio_account_sid = "AC..."
# twilio_auth_token  = "..."

# Adopt the existing Supabase project into state (never recreated, prevent_destroy):
# manage_supabase_project  = true
# supabase_access_token    = "sbp_..."
# supabase_organization_id = "..."
